NODE_ENV=development

# Development URLs
BACKEND_DEVELOPMENT_URL=http://127.0.0.1:3000
FRONTEND_DEVELOPMENT_URL=http://127.0.0.1:5173

# Production URLs
BACKEND_PRODUCTION_URL=https://lif-xp64.onrender.com
FRONTEND_PRODUCTION_URL=https://your-lif-frontend.vercel.app

# Active URLs are resolved by the backend from NODE_ENV.

# Required backend credentials (replace with local values; never commit them).
DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=replace-with-a-long-random-secret
